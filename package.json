{
  "name": "cotiobra-cr",
  "private": true,
  "version": "1.0.0",
  "description": "CotiObra CR — cotizador de obra (React + Vite + Firebase)",
  "scripts": {
    "install:app": "npm --prefix cotiobra-cr install",
    "dev": "npm --prefix cotiobra-cr run dev",
    "build": "npm --prefix cotiobra-cr run build",
    "lint": "npm --prefix cotiobra-cr run lint",
    "preview": "npm --prefix cotiobra-cr run preview",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:todo": "firebase deploy --only hosting,firestore:rules"
  }
}
