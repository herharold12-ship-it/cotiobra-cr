rules_version = '2';

// Reglas de Firestore para CotiObra CR.
// Solo usuarios autenticados pueden leer o escribir los datos de la empresa:
// cotizaciones, proyectos (obras) y facturas de gasto real.
// Publicar con: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /cotizaciones/{cotizacionId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /proyectos/{proyectoId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /facturas/{facturaId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // El resto de la base de datos queda cerrado por defecto.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
